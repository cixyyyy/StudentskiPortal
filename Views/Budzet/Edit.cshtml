@model PrijavaIspita.Models.BudzetBO

<h2>Izmeni budžet</h2>

<form asp-action="Edit" method="post">
    @Html.HiddenFor(model => model.Id)

    <div class="form-group">
        <label>Korisnik</label>
        <input class="form-control" value="@Model.Korisnik.Ime @Model.Korisnik.Prezime" disabled />
    </div>

    <div class="form-group">
        <label>Iznos</label>
        @Html.EditorFor(model => model.Iznos, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="form-group">
        <label>Status</label>
        @Html.EditorFor(model => model.Status, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Sačuvaj</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
