@model PrijavaIspita.Models.BudzetBO

<h2>Dodaj budžet</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label>Korisnik</label>
        @Html.DropDownList(
                              "KorisnikId",
                              new SelectList(ViewBag.Korisnici, "Id", "ImePrezime"),
                              "Selektuj korisnika",
                              new { @class = "form-control" }
                          )
    </div>

    <div class="form-group">
        <label>Iznos</label>
        @Html.EditorFor(model => model.Iznos, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <div class="form-group">
        <label>Status</label>
        @Html.EditorFor(model => model.Status, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <br />
    <button type="submit" class="btn btn-primary">Dodaj</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
