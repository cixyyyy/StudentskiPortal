@model PrijavaIspita.Models.KorisnikBO

<h2>Obriši korisnika</h2>

<p>Da li ste sigurni da želite da obrišete ovog korisnika?</p>

<dl class="row">
    <dt class="col-sm-2">Ime</dt>
    <dd class="col-sm-10">@Model.Ime</dd>

    <dt class="col-sm-2">Prezime</dt>
    <dd class="col-sm-10">@Model.Prezime</dd>

    <dt class="col-sm-2">Smer</dt>
    <dd class="col-sm-10">@Model.Smer.Naziv</dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Obriši</button>
    <a asp-action="Index" class="btn btn-secondary">Nazad</a>
</form>
