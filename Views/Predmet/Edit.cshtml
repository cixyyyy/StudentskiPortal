@model PrijavaIspita.Models.PredmetBO
@{
    ViewBag.Title = "Izmeni predmet";
}

<h2>Izmena predmeta</h2>

<form asp-action="Edit" asp-controller="Predmet" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-2">
        <label asp-for="Naziv"></label>
        <input asp-for="Naziv" class="form-control" />
        <span asp-validation-for="Naziv" class="text-danger"></span>
    </div>

   <div class="form-group mb-2">
    <label asp-for="ProfesorID">Profesor</label>
    <select asp-for="ProfesorID" class="form-control" asp-items="ViewBag.Profesori">
            <option value="">-- Odaberite profesora --</option>
    </select>
        <span asp-validation-for="ProfesorID" class="text-danger"></span>
    </div>



    <div class="form-group mb-2">
        <label asp-for="SmerId">Smer</label>
        <select asp-for="SmerId" class="form-control" asp-items="ViewBag.Smerovi"></select>
        <span asp-validation-for="SmerId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Sačuvaj izmene</button>
</form>
